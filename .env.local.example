# Resend API Key — obtenir sur https://resend.com
# Renommer ce fichier en .env.local et remplacer la valeur
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL du webhook n8n déclenché à chaque soumission du formulaire de contact
# Exposée côté client (préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://n8n.example.com/webhook/xxxxxxxx

# Supabase — sauvegarde des demandes de contact dans la table "contacts"
# Clés publiques (préfixe NEXT_PUBLIC_) utilisées côté client depuis le formulaire
# La protection doit être assurée par les RLS policies sur la table "contacts"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# PayPal — créer une app sur https://developer.paypal.com (mode Sandbox d'abord)
# - Dashboard → Apps & Credentials → Sandbox → Create App → REST API
# - Copier "Client ID" et "Secret"
# PAYPAL_ENV : "sandbox" pour les tests, "live" pour la prod
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=AeXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_SECRET=EHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Le Client ID est aussi exposé côté client pour le SDK (préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=AeXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Devise PayPal — XPF non supporté, choisir EUR ou USD
NEXT_PUBLIC_PAYPAL_CURRENCY=EUR
