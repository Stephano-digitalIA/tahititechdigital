# Resend API Key — obtenir sur https://resend.com
# Renommer ce fichier en .env.local et remplacer la valeur
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL du webhook n8n déclenché à chaque soumission du formulaire de contact
# Exposée côté client (préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://n8n.example.com/webhook/xxxxxxxx

# Supabase — sauvegarde des demandes de contact dans la table "contacts"
# Clés publiques (préfixe NEXT_PUBLIC_) utilisées côté client depuis le formulaire
# La protection doit être assurée par les RLS policies sur la table "contacts"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...
